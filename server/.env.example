# ═══════════════════════════════════════════════════════════════════════════════
# PromptHash auxiliary server (Express + MongoDB)
# Copy to server/.env when running the backend locally.
# ═══════════════════════════════════════════════════════════════════════════════
#
# LEGEND:
#   ✅ REQUIRED — server will fail to start or function without this value.
#   ➕ OPTIONAL — feature-specific; safe to leave commented out.

# ✅ MongoDB connection string for draft lifecycle, buyer collections, chat.
MONGODB_URI=mongodb://127.0.0.1:27017/prompt-hash-stellar

# ➕ Email notifications (for creator alerts on purchases)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# ➕ S3 backup (see docs/operations/backup-and-recovery.md)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
