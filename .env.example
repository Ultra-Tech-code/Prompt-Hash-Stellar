# ═══════════════════════════════════════════════════════════════════════════════
# PromptHash Stellar — environment configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in the required values before running the app.
#   cp .env.example .env
#
# LEGEND:
#   ✅ REQUIRED — app will fail to start or function without this value.
#   ➕ OPTIONAL — feature-specific; safe to leave commented out.
#   🔐 SECRET  — sensitive value; never commit or expose in client bundles.

# ═══════════════════════════════════════════════════════════════════════════════
# SHARED RUNTIME
# ═══════════════════════════════════════════════════════════════════════════════

STELLAR_SCAFFOLD_ENV=development
XDG_CONFIG_HOME=.config

# ═══════════════════════════════════════════════════════════════════════════════
# FRONTEND RUNTIME  (prefix PUBLIC_ — bundled for browser use)
# ═══════════════════════════════════════════════════════════════════════════════

# ✅ Stellar network to connect to.
#    Valid values: TESTNET, PUBLIC, LOCAL, FUTURENET, STANDALONE
PUBLIC_STELLAR_NETWORK=TESTNET

# ✅ Network passphrase matching the network above.
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ✅ Stellar RPC URL for Soroban contract interactions.
PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# ✅ Stellar Horizon URL for account balance and transaction queries.
PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ✅ PromptHash contract ID deployed on the configured network.
PUBLIC_PROMPT_HASH_CONTRACT_ID=CA3C5O3P7XPL6D6T6WZ5J7S2Y4KJ5H6G7F8D9S0A1B2C3D4E5F6G7H8I9J

# ✅ Stellar native asset contract ID (SAC wrapper for XLM).
PUBLIC_STELLAR_NATIVE_ASSET_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# ✅ Simulation account for dry-run contract calls.
PUBLIC_STELLAR_SIMULATION_ACCOUNT=GB7NA6L5R5H6J7K8L9M0N1O2P3Q4R5S6T7U8V9W0X1Y2Z3A4B5C6D7E8F9G

# 🔐 Public key (base64) for encrypting prompt content in the browser.
#    Must match the key pair used by the unlock service.
PUBLIC_UNLOCK_PUBLIC_KEY=BASE64_PUBLIC_KEY

# ➕ Optional external chat gateway URL used by the chat UI.
PUBLIC_CHAT_API_BASE=https://secret-ai-gateway.onrender.com

# ═══════════════════════════════════════════════════════════════════════════════
# SERVERLESS UNLOCK SERVICE  (server-side only — never exposed to clients)
# ═══════════════════════════════════════════════════════════════════════════════

# 🔐 REQUIRED. Secret used to sign and verify challenge tokens.
#    Generate with: openssl rand -base64 32
CHALLENGE_TOKEN_SECRET=replace-with-a-long-random-secret

# 🔐 REQUIRED. Public key (base64) for unwrapping encryption keys.
UNLOCK_PUBLIC_KEY=BASE64_PUBLIC_KEY

# 🔐 REQUIRED. Private key (base64) for unwrapping encryption keys.
#    Never share this value. Never commit it. Keep it in secrets manager.
UNLOCK_PRIVATE_KEY=BASE64_PRIVATE_KEY

# ➕ Unlock service secret rotation (see docs/secret-rotation.md)
#    Enable rotation by uncommenting and setting these values:
# ADMIN_ROTATION_TOKEN=
# CHALLENGE_TOKEN_SECRET_PREVIOUS=
# CHALLENGE_TOKEN_ROTATION_TIMESTAMP=
# CHALLENGE_TOKEN_GRACE_PERIOD_MS=300000

# ➕ Rate limiting (falls back to in-memory when unset; set REDIS_URL for
#    persistent rate-limit counters across deployments).
# REDIS_URL=
